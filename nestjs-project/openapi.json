  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "CreateVideoDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "filename": {
            "type": "string",
            "maxLength": 255,
            "example": "video.mp4"
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 10000000000
          }
        },
        "required": [
          "title",
          "filename",
          "size"
        ]
      },
      "VideoMetadataDto": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "codec": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "size": {
            "type": "number"
          }
        },
        "required": [
          "width",
          "height",
          "codec",
          "format",
          "size"
        ]
      },
      "VideoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "processing",
              "ready",
              "error"
            ]
          },
          "part_size": {
            "type": "number"
          },
          "part_count": {
            "type": "number"
          },
          "duration": {
            "type": "number",
            "nullable": true
          },
          "metadata": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/VideoMetadataDto"
              }
            ]
          },
          "error_code": {
            "type": "string",
            "nullable": true
          },
          "stream_url": {
            "type": "string"
          },
          "download_url": {
            "type": "string"
          },
          "thumbnail_url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "filename",
          "size",
          "status",
          "part_size",
          "part_count",
          "stream_url",
          "download_url",
          "thumbnail_url"
        ]
      },
      "UploadedPartDto": {
        "type": "object",
        "properties": {
          "part_number": {
            "type": "number"
          },
          "size": {
            "type": "number"
          },
          "etag": {
            "type": "string"
          }
        },
        "required": [
          "part_number",
          "size",
          "etag"
        ]
      },
      "UploadResponseDto": {
        "type": "object",
        "properties": {
          "part_size": {
            "type": "number"
          },
          "part_count": {
            "type": "number"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadedPartDto"
            }
          }
        },
        "required": [
          "part_size",
          "part_count",
          "parts"
        ]
      },
      "SignedPartDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Temporary signed PUT URL. Do not log or share."
          },
          "expires_in": {
            "type": "number"
          },
          "size": {
            "type": "number"
          }
        },
        "required": [
          "url",
          "expires_in",
          "size"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      }
    }
  }
}